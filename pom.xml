<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.sgruendel</groupId>
    <artifactId>lucide-jte</artifactId>
    <version>1.54.0-SNAPSHOT</version>
    <name>Lucide for JTE</name>
    <description>Type-safe Lucide icon components for Java Template Engine (JTE).</description>
    <url>https://github.com/sgruendel/lucide-jte</url>
    <licenses>
        <license><name>MIT License</name><url>https://opensource.org/license/mit</url></license>
        <license><name>ISC License (Lucide icons)</name><url>https://opensource.org/license/isc-license-txt</url></license>
    </licenses>
    <developers>
        <developer><id>sgruendel</id><name>Stefan Gründel</name><url>https://github.com/sgruendel</url></developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/sgruendel/lucide-jte.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/sgruendel/lucide-jte.git</developerConnection>
        <url>https://github.com/sgruendel/lucide-jte</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement><system>GitHub</system><url>https://github.com/sgruendel/lucide-jte/issues</url></issueManagement>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jte.version>3.2.4</jte.version>
        <junit.version>6.0.3</junit.version>
    </properties>
    <dependencies>
        <dependency><groupId>gg.jte</groupId><artifactId>jte-runtime</artifactId><version>${jte.version}</version></dependency>
        <dependency>
            <groupId>gg.jte</groupId><artifactId>jte-models</artifactId><version>${jte.version}</version>
            <exclusions>
                <exclusion><groupId>gg.jte</groupId><artifactId>jte</artifactId></exclusion>
                <exclusion><groupId>gg.jte</groupId><artifactId>jte-extension-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <resource>
                <directory>${project.basedir}</directory><targetPath>META-INF</targetPath>
                <includes><include>LICENSE</include><include>THIRD-PARTY-LICENSES/**</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>gg.jte</groupId><artifactId>jte-maven-plugin</artifactId><version>${jte.version}</version>
                <configuration>
                    <sourceDirectory>${project.basedir}/src/main/jte</sourceDirectory>
                    <contentType>Html</contentType>
                    <packageName>io.github.sgruendel.lucide.jte</packageName>
                    <binaryStaticContent>true</binaryStaticContent>
                    <targetResourceDirectory>${project.build.outputDirectory}</targetResourceDirectory>
                    <extensions>
                        <extension>
                            <className>gg.jte.models.generator.ModelExtension</className>
                            <settings><interfaceName>LucideIcon</interfaceName></settings>
                        </extension>
                    </extensions>
                </configuration>
                <executions><execution><id>generate-icons</id><phase>generate-sources</phase><goals><goal>generate</goal></goals></execution></executions>
                <dependencies><dependency><groupId>gg.jte</groupId><artifactId>jte-models</artifactId><version>${jte.version}</version></dependency></dependencies>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-invoker-plugin</artifactId><version>3.9.1</version>
                <configuration>
                    <projectsDirectory>${project.basedir}/examples</projectsDirectory>
                    <cloneProjectsTo>${project.build.directory}/consumer-tests</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/consumer-repository</localRepositoryPath>
                    <streamLogs>false</streamLogs>
                    <goals><goal>clean</goal><goal>verify</goal></goals>
                    <properties><lucide-jte.version>${project.version}</lucide-jte.version><jte.version>${jte.version}</jte.version></properties>
                </configuration>
                <executions>
                    <execution><id>install-consumer-dependency</id><phase>pre-integration-test</phase><goals><goal>install</goal></goals></execution>
                    <execution><id>verify-consumer</id><phase>integration-test</phase><goals><goal>run</goal></goals></execution>
                    <execution><id>check-consumer</id><phase>verify</phase><goals><goal>verify</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>release</id>
            <build><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.3.1</version>
                    <executions><execution><id>sources</id><phase>package</phase><goals><goal>jar-no-fork</goal></goals></execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.11.2</version>
                    <configuration>
                        <doclint>all,-missing</doclint>
                        <sourceFileExcludes><sourceFileExclude>**/Jte*Generated.java</sourceFileExclude></sourceFileExcludes>
                        <excludePackageNames>io.github.sgruendel.lucide.jte.internal</excludePackageNames>
                    </configuration>
                    <executions><execution><id>javadoc</id><phase>package</phase><goals><goal>jar</goal></goals></execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version>
                    <executions><execution><id>sign</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.11.0</version>
                    <extensions>true</extensions>
                    <configuration><publishingServerId>central</publishingServerId><autoPublish>false</autoPublish></configuration>
                </plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>
